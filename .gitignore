# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 前端
node_modules/
web/dist/
*.local
.npm-cache/

# 运行数据
# app/data 含 SQLite 库与 JWT 签名密钥（.jwt_secret），禁止入库
app/data/
app/uploads/
app/backups/
*.db
*.sqlite3
logs/
*.log

# 环境与编辑器
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db

# 浏览器技能插件的运行状态（勿入库）
.browser4-cli/
.browser4-state/

# DSH 工具环境（技能定义、本地会话配置；属本机工具，不是项目内容）
.dsh/

# Playwright E2E 产物（报告 / 失败截图 / trace / 用例临时目录）
web/test-results/
web/tests/e2e-report/
web/playwright-report/
web/blob-report/
web/.playwright/

# Docker 镜像导出产物（docker save 出来的 tar 约 200MB，禁止入库；
# 需要用 scripts/export-docker.bat 在本地重新生成）
ctms-image-*.tar
ctms-image-*.tar.gz
