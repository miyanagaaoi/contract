# CTMS 单容器镜像（前端 + 后端，多阶段构建）
# 构建：docker build -t ctms:2.6.2 -f deploy/Dockerfile.single .
# 或：  scripts\export-docker.bat 2.6.2   （构建 + 导出 core.tar.gz）
#
# V2.6.2（CR-026）：**仅此一个镜像**，不含 Playwright/Chromium；
# 发票走「上传单张 PDF / ZIP → 文本层识别入库」通道。

# ---------- 阶段 1：构建前端 ----------
FROM node:20-alpine AS fe
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /build
COPY web/package.json web/package-lock.json* ./
RUN npm config set registry ${NPM_REGISTRY} && \
    (npm ci --no-audit --no-fund || npm install --no-audit --no-fund)
COPY web/ ./
RUN npm run build && ls -la /build/dist

# ---------- 阶段 2：运行（Python） ----------
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    CTMS_DB_URL=sqlite:////data/ctms.db \
    CTMS_UPLOAD_DIR=/data/uploads \
    CTMS_LOG_DIR=/data/logs \
    CTMS_SERVE_STATIC=1 \
    CTMS_WEB_DIST=/srv/web/dist
COPY app/requirements.txt app/requirements-pg.txt /app/
# V2.3：一并安装 PostgreSQL 驱动，单容器镜像可通过 CTMS_DB_URL 直连 PostgreSQL
RUN pip install --no-cache-dir -r /app/requirements.txt -r /app/requirements-pg.txt
COPY app/ /app/app/
COPY --from=fe /build/dist /srv/web/dist

VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4)" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
