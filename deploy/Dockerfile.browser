# CTMS 浏览器底座镜像（V2.6，**固定层**，几乎不需要更新）
# 内容：python:3.13-slim + Playwright + Chromium + 中文字体（不装业务代码）
# 构建：docker build -t ctms-browser:1 -f deploy/Dockerfile.browser .
# 导出：docker save ctms-browser:1 | gzip > ctms-browser-1.tar.gz
#
# 作用：作为「同步镜像」的不变下层。以后业务更新只需替换业务镜像，
#       浏览器层原地不动（见 deploy/Dockerfile.sync-local）。
# 何时需要重建本底座：Chromium/Playwright 版本升级、或 Python 大版本变化。
FROM python:3.13-slim

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    DEBIAN_FRONTEND=noninteractive

# 国内网络：apt 与 playwright 均走镜像源
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    || sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list || true

RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "playwright>=1.45" \
    && PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright/ \
       python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
